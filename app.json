{
  "expo": {
    "name": "Habit Tracker",
    "slug": "habit-tracker",
    "version": "2.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.habittrackerwasiii.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09201B"
      },
      "package": "com.habittrackerwasiii.app",
      "versionCode": 2,
      "permissions": [],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ab0bafd3-c5f4-44d6-8f87-0b399225a043"
      }
    },
    "owner": "wasii",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-notifications"
    ]
  }
}
